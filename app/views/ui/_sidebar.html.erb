<%# locals: (items:, footer_items: [], user_name: nil, user_email: nil, active_controller: nil) %>
<aside data-type="sidebar" id="app-sidebar" data-collapsed="false" data-open="false">
  <%# Header: toggle + logo %>
  <div data-slot="sidebar-header" class="flex flex-row items-center gap-2 px-2 py-3">
    <button data-type="sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle sidebar">
      <%= lucide_icon("menu", class: "size-5") %>
    </button>
    <%= image_tag "arbolitics_logo.svg", alt: "arbolitics", data: { slot: "sidebar-logo" } %>
  </div>

  <%# Main navigation %>
  <div data-slot="sidebar-content">
    <ul data-slot="sidebar-menu">
      <% items.each do |item| %>
        <%= render "ui/sidebar_menu_item",
          label: item[:label],
          icon: item[:icon],
          href: item[:href],
          active: item[:active] || (active_controller && item[:controller] == active_controller) %>
      <% end %>
    </ul>
  </div>

  <%# Footer %>
  <div data-slot="sidebar-footer">
    <ul data-slot="sidebar-menu" class="list-none border-t border-sidebar-border pt-2">
      <% footer_items.each do |item| %>
        <%= render "ui/sidebar_menu_item",
          label: item[:label],
          icon: item[:icon],
          href: item[:href],
          active: item[:active] || false %>
      <% end %>

      <% if user_name && user_email %>
        <li>
          <button data-type="sidebar-user-button">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted">
              <%= lucide_icon("user", class: "size-4") %>
            </span>
            <div class="grid flex-1 text-left text-sm leading-tight">
              <span class="truncate font-medium"><%= user_name %></span>
              <span class="truncate text-xs text-muted-foreground"><%= user_email %></span>
            </div>
            <%= lucide_icon("chevrons-up-down", class: "ml-auto size-4") %>
          </button>
        </li>
      <% end %>
    </ul>
  </div>
</aside>

<div data-slot="sidebar-backdrop" data-visible="false"></div>

<script>
  (function () {
    if (window.__appSidebarSetup) return;
    window.__appSidebarSetup = true;

    function getSidebar() { return document.getElementById("app-sidebar"); }
    function getBackdrop() { return document.querySelector('[data-slot="sidebar-backdrop"]'); }
    function isMobile() { return window.innerWidth < 768; }

    window.openMobileSidebar = function () {
      var sidebar = getSidebar();
      if (!sidebar) return;
      sidebar.setAttribute("data-open", "true");
      var backdrop = getBackdrop();
      if (backdrop) backdrop.setAttribute("data-visible", "true");
    };

    window.closeMobileSidebar = function () {
      var sidebar = getSidebar();
      if (!sidebar) return;
      sidebar.setAttribute("data-open", "false");
      var backdrop = getBackdrop();
      if (backdrop) backdrop.setAttribute("data-visible", "false");
    };

    window.toggleSidebar = function () {
      if (isMobile()) {
        closeMobileSidebar();
      } else {
        var sidebar = getSidebar();
        var layout = sidebar && sidebar.closest("[data-type='sidebar-layout']");
        var collapsed = sidebar && sidebar.getAttribute("data-collapsed") === "true";
        if (sidebar) sidebar.setAttribute("data-collapsed", String(!collapsed));
        if (layout) layout.setAttribute("data-collapsed", String(!collapsed));
      }
    };

    document.addEventListener("click", function (e) {
      if (e.target.closest('[data-slot="sidebar-backdrop"]')) {
        closeMobileSidebar();
      }
    });
  })();
</script>
