<%# locals: (title:, subtitle_texts: [], cards: [], reversed: false, section_id: "solutions") %>
<%
  grid_cols   = reversed ? "lg:grid-cols-[55%_1fr]" : "lg:grid-cols-[1fr_55%]"
  text_order  = reversed ? "lg:order-2" : "lg:order-1"
  cards_order = reversed ? "lg:order-1" : "lg:order-2"
%>
<section class="py-30 bg-white grid grid-cols-1 gap-12 text-primary px-4 justify-center <%= grid_cols %>" id="<%= section_id %>">

  <%# Text block %>
  <div class="flex flex-col gap-6 mt-0 lg:mt-10 <%= text_order %>">
    <div class="flex items-center gap-2 text-2xl font-semibold"><%= title %></div>
    <% subtitle_texts.each do |text| %>
      <div class="text-xl"><%= text %></div>
    <% end %>
  </div>

  <%# Cards grid %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 <%= cards_order %>">
    <% cards.each do |card| %>
      <%= render "ui/landing_page_components/solution_card",
            icon_paths:  card[:icon_paths],
            title:       card[:title],
            description: card[:description],
            url:         card[:url] %>
    <% end %>
  </div>

</section>
