<%# locals: (image_src:, image_alt:, title:, description:, url:) %>
<div data-slot="card" class="text-card-foreground flex flex-col rounded-xl transition-all duration-500 py-0 overflow-hidden border-0 shadow-lg bg-background h-120 gap-0">

  <%# Image %>
  <div class="w-full flex-1 overflow-hidden relative">
    <img alt="<%= image_alt %>" class="w-full object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;" src="<%= image_src %>" />
  </div>

  <%# Content %>
  <div data-slot="card-content" class="flex flex-col gap-8 justify-evenly p-4 sm:p-6">
    <div class="text-secondary-foreground">
      <div class="text-sm sm:text-xl font-semibold"><%= title %></div>
      <div class="text-xs sm:text-base mt-2"><%= description %></div>
    </div>
    <div>
      <a class="text-base py-2 font-medium opacity-90 hover:text-primary transition-colors hover:no-underline" href="<%= url %>">
        <button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-12 rounded-md px-6 cursor-pointer w-full">
          Read more
          <svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" class="ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </a>
    </div>
  </div>

</div>
