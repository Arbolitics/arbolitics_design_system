<%# Landing page home — Lookbook preview
    Layout: landings/home/marketing (provides nav, footer, shared marketing CSS)
    Content: hero + solutions + insights + contact sections %>

<%# ===== Hero ===== %>
<section class="relative flex items-center justify-center overflow-hidden text-white" style="min-height: 560px; background: linear-gradient(135deg, #023020 0%, #045e40 60%, #067a52 100%);">
  <div class="absolute inset-0 opacity-20" style="background: url('/assets/leaf.png') center center / cover no-repeat;"></div>
  <div class="relative z-10 text-center px-6 max-w-3xl mx-auto py-20">
    <h1 class="text-5xl font-bold leading-tight mb-5">Farm data experts</h1>
    <p class="text-lg opacity-90 leading-relaxed mb-10 max-w-xl mx-auto">
      Precision agriculture intelligence for farmers, banks, and investors. Plot-level analytics that turn field data into confident decisions.
    </p>
    <a href="#solutions" class="inline-flex items-center gap-2 bg-white text-[#045e40] font-semibold px-7 py-3.5 rounded-lg hover:bg-[#DBE1C1] transition-colors text-base">
      Explore our solutions <i class="bi bi-arrow-down"></i>
    </a>
  </div>
</section>

<%# ===== Farming solutions ===== %>
<section id="solutions" class="py-20 bg-white">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid gap-12 items-center lg:grid-cols-[1fr_55%]">

      <%# Left — text %>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#045e40] mb-3">For farmers</p>
        <h2 class="text-3xl font-bold text-gray-900 mb-4 leading-snug">Smarter decisions for every plot</h2>
        <p class="text-gray-500 leading-relaxed mb-8">
          Arbolitics puts satellite intelligence, irrigation precision, and yield analytics directly in the hands of growers — so every season starts with better data.
        </p>
        <a href="#" class="inline-flex items-center gap-2 bg-[#045e40] text-white font-semibold px-6 py-3 rounded-lg hover:bg-[#034b35] transition-colors">
          Learn more <i class="bi bi-arrow-right"></i>
        </a>
      </div>

      <%# Right — 3 solution cards %>
      <div class="grid gap-4 sm:grid-cols-1">

        <div class="flex items-start gap-4 rounded-xl p-5 bg-[#DBE1C1]">
          <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#045e40] flex items-center justify-center text-white text-xl">
            <i class="bi bi-droplet-half"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Irrigation planner</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Plot-level weekly irrigation schedules based on ETo, crop coefficients, and local forecast data.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 rounded-xl p-5 bg-[#DBE1C1]">
          <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#045e40] flex items-center justify-center text-white text-xl">
            <i class="bi bi-broadcast"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Satellite detection &amp; alerts</h3>
            <p class="text-sm text-gray-600 leading-relaxed">NDVI anomaly detection from Planet Scope imagery. Spot crop stress early — before it becomes a loss.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 rounded-xl p-5 bg-[#DBE1C1]">
          <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#045e40] flex items-center justify-center text-white text-xl">
            <i class="bi bi-graph-up-arrow"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Yield estimations</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Season-ahead yield forecasts per parcel, derived from multi-year climate and satellite baselines.</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%# ===== Finance solutions (reversed) ===== %>
<section class="py-20 bg-[#f8f9f4]">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid gap-12 items-center lg:grid-cols-[55%_1fr]">

      <%# Left — 3 solution cards %>
      <div class="grid gap-4">

        <div class="flex items-start gap-4 rounded-xl p-5 bg-white shadow-sm border border-gray-100">
          <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#045e40] flex items-center justify-center text-white text-xl">
            <i class="bi bi-shield-check"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Credit risk scoring</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Agronomical credit scores that combine satellite data, climate risk, and multi-year yield history.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 rounded-xl p-5 bg-white shadow-sm border border-gray-100">
          <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#045e40] flex items-center justify-center text-white text-xl">
            <i class="bi bi-bar-chart-line"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Yield estimations</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Plot-level yield forecasts to benchmark collateral value and set realistic repayment timelines.</p>
          </div>
        </div>

        <div class="flex items-start gap-4 rounded-xl p-5 bg-white shadow-sm border border-gray-100">
          <div class="flex-shrink-0 w-11 h-11 rounded-lg bg-[#045e40] flex items-center justify-center text-white text-xl">
            <i class="bi bi-pie-chart"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-1">Portfolio risk analytics</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Aggregate exposure view across all borrower plots — regional climate clusters and concentration risk at a glance.</p>
          </div>
        </div>

      </div>

      <%# Right — text %>
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#045e40] mb-3">For institutions</p>
        <h2 class="text-3xl font-bold text-gray-900 mb-4 leading-snug">Agricultural risk, made measurable</h2>
        <p class="text-gray-500 leading-relaxed mb-8">
          Banks, investors, and insurers use Arbolitics to quantify agricultural exposure with the same rigour applied to any other asset class.
        </p>
        <a href="#" class="inline-flex items-center gap-2 bg-[#045e40] text-white font-semibold px-6 py-3 rounded-lg hover:bg-[#034b35] transition-colors">
          Learn more <i class="bi bi-arrow-right"></i>
        </a>
      </div>

    </div>
  </div>
</section>

<%# ===== Custom data section ===== %>
<section class="py-20 bg-white text-center">
  <div class="max-w-[1200px] mx-auto px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-[#045e40] mb-3">Tailored solutions</p>
    <h2 class="text-3xl font-bold text-gray-900 mb-4">Custom data integrations</h2>
    <p class="text-gray-500 leading-relaxed max-w-2xl mx-auto mb-10">
      Need a bespoke agronomical dataset or a white-label analytics feed? Our data engineering team designs and delivers custom pipelines for satellite, climate, and field-sensor data at any scale.
    </p>
    <a href="#contact" class="inline-flex items-center gap-2 border-2 border-[#045e40] text-[#045e40] font-semibold px-7 py-3 rounded-lg hover:bg-[#045e40] hover:text-white transition-colors">
      Talk to us <i class="bi bi-arrow-right"></i>
    </a>
  </div>
</section>

<%# ===== Insights section ===== %>
<section class="py-20 bg-stone-100">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 class="text-3xl font-bold text-gray-900 text-center mb-2">Latest insights</h2>
    <p class="text-gray-500 text-center mb-12 max-w-xl mx-auto">Research, case studies, and data perspectives from the Arbolitics team.</p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

      <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-44 bg-[#045e40] flex items-center justify-center text-white text-4xl">
          <i class="bi bi-satellite2"></i>
        </div>
        <div class="p-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#045e40] mb-2">Remote sensing</p>
          <h3 class="font-bold text-gray-900 mb-2 leading-snug">How satellite NDVI tracks avocado yield before harvest</h3>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">A six-season study across 340 plots in Mexico correlating spectral indices with actual yield outcomes.</p>
          <a href="#" class="text-[#045e40] font-semibold text-sm inline-flex items-center gap-1 hover:underline">
            Read more <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </article>

      <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-44 bg-[#6b4c2a] flex items-center justify-center text-white text-4xl">
          <i class="bi bi-cup-hot"></i>
        </div>
        <div class="p-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#045e40] mb-2">Crop finance</p>
          <h3 class="font-bold text-gray-900 mb-2 leading-snug">Cocoa credit risk: the case for plot-level scoring</h3>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">Why aggregated country-level indices miss the microclimate variance that drives smallholder default rates.</p>
          <a href="#" class="text-[#045e40] font-semibold text-sm inline-flex items-center gap-1 hover:underline">
            Read more <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </article>

      <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-44 bg-[#3a6b2a] flex items-center justify-center text-white text-4xl">
          <i class="bi bi-flower1"></i>
        </div>
        <div class="p-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-[#045e40] mb-2">Precision agriculture</p>
          <h3 class="font-bold text-gray-900 mb-2 leading-snug">Irrigation efficiency gains from ETo-based scheduling</h3>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">Farmers using algorithm-driven schedules applied 18% less water while maintaining equivalent yields across three crop types.</p>
          <a href="#" class="text-[#045e40] font-semibold text-sm inline-flex items-center gap-1 hover:underline">
            Read more <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </article>

    </div>

    <div class="text-center mt-10">
      <a href="#" class="text-[#045e40] font-semibold inline-flex items-center gap-2 hover:underline">
        View all insights <i class="bi bi-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<%# ===== Contact section ===== %>
<section id="contact" class="py-20 bg-white">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid gap-0 overflow-hidden rounded-2xl shadow-lg lg:grid-cols-2">

      <%# Left — info panel %>
      <div class="bg-[#045e40] text-white p-10 lg:p-12 flex flex-col justify-center">
        <h2 class="text-3xl font-bold mb-4">Get in touch</h2>
        <p class="opacity-90 leading-relaxed mb-8">
          Whether you're a grower looking for precision tools or an institution exploring agricultural risk data — we'd love to hear from you.
        </p>
        <div class="flex items-center gap-3 mb-4">
          <i class="bi bi-geo-alt-fill text-xl opacity-80"></i>
          <span class="text-sm opacity-90">Berlin, Germany</span>
        </div>
        <div class="flex items-center gap-3">
          <i class="bi bi-envelope-fill text-xl opacity-80"></i>
          <span class="text-sm opacity-90">contact@arbolitics.com</span>
        </div>
      </div>

      <%# Right — contact form (inlined to avoid missing contact_create_path in preview) %>
      <div class="bg-white p-10 lg:p-12">
        <form class="flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <input type="text" placeholder="First name" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#045e40]">
            <input type="text" placeholder="Last name" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#045e40]">
          </div>
          <input type="email" placeholder="Email address" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#045e40]">
          <input type="text" placeholder="Company (optional)" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#045e40]">
          <select class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm text-gray-500 focus:outline-none focus:ring-2 focus:ring-[#045e40]">
            <option value="" disabled selected>I am a…</option>
            <option>Farmer</option>
            <option>Bank / Agricultural lender</option>
            <option>Investor</option>
            <option>Supply chain partner</option>
            <option>Insurance provider</option>
            <option>Consultant</option>
            <option>Other</option>
          </select>
          <textarea rows="4" placeholder="Your message" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-[#045e40]"></textarea>
          <button type="button" class="w-full bg-[#045e40] text-white font-semibold py-3 rounded-lg hover:bg-[#034b35] transition-colors flex items-center justify-center gap-2">
            Send message <i class="bi bi-send"></i>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
